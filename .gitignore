# NPM 패키지용 .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Package managers
.npm
.yarn
.pnp
.pnp.*
yarn.lock
pnpm-lock.yaml

# Build outputs (TypeScript 컴파일 결과)
/dist/
/build/
*.tsbuildinfo

# Testing
/coverage/
.nyc_output
*.lcov

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# NPM package related
*.tgz
.npmrc

# TypeScript
*.d.ts.map

# Optional: 로컬 개발 시 생성되는 파일들
.vscode/settings.json
.history/

# Optional: Documentation build (if using tools like typedoc)
/docs/

# Optional: Benchmark results
benchmark/